# ==============================================================================
# KURONEX GAMES — Environment Configuration (.env.example)
# ==============================================================================

# ── APPLICATION ENVIRONMENT ──
# "production" enforces strict security checks, suppresses internal stack traces,
# requires explicit secrets, and disables dev admin auto-provisioning.
NODE_ENV=development
PORT=3000

# Canonical public origin for CORS and CSRF Origin verification
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── DATABASE PERSISTENCE ──
# Local SQLite database (default during current development phase):
#   Use with: npm run db:generate && npm run db:push && npm run db:seed
DATABASE_URL="file:./kuronex.db"
#
# Production PostgreSQL example (use with prisma/schema.prisma):
# DATABASE_URL="postgresql://kuronex_admin:SecurePassword123@db.internal:5432/kuronex_db?schema=public&sslmode=require"

# ── CRYPTOGRAPHY & SECURITY SECRETS ──
# 64-character random key used for signing/hashing tokens
SESSION_SECRET=replace_with_64_char_cryptographically_secure_random_key_in_production

# Secret salt applied to SHA-256 telemetry IP hashing for GDPR/privacy anonymization
ANALYTICS_SALT=replace_with_random_telemetry_salt_key_in_production

# Master setup passkey required on POST /api/admin/auth/register
# Must be set explicitly in production and non-dev environments.
ADMIN_SETUP_PASSKEY=replace_with_strong_team_admin_setup_passkey

# ── OBSERVABILITY & LOGGING ──
# Log levels: DEBUG, INFO, WARN, ERROR, FATAL
LOG_LEVEL=INFO

# ── RATE LIMITING ──
# Max authentication requests per minute per IP address (default: 15 in prod, 120 in dev)
RATE_LIMIT_LOGIN_MAX=15

# ── DEVELOPMENT ONLY SEEDING (Disabled in NODE_ENV=production) ──
# Optional local admin bootstrap credentials if no admin exists yet.
DEV_ADMIN_USERNAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
